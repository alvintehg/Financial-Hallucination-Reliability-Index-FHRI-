# Copy to .env and fill in your own keys. Never commit .env.

# LLM providers (at least one required; DeepSeek takes priority)
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Market data
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
EDGAR_CONTACT_EMAIL=
MAX_QUOTE_AGE_SECONDS=900

# Advisory services
ADVISOR_CONTACT_EMAIL=

# Hallucination detection
HALLU_THRESHOLD=2.0
ENTROPY_TIMEOUT=10.0
NLI_TIMEOUT=5.0

# LLM settings
LLM_TIMEOUT=30

# Logging / debugging
DEBUG=0
LOG_TO_FILE=0
